{
  "expo": {
    "name": "Scoutvy",
    "slug": "scoutvy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/scoutvy-splash.png",
    "scheme": "scoutvy",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/scoutvy.icon",
      "bundleIdentifier": "com.scoutvy.app"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#AB9FF3",
        "foregroundImage": "./assets/images/scoutvy-splash.png",
        "monochromeImage": "./assets/images/scoutvy-splash.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.scoutvy.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "scoutvy.vercel.app",
              "pathPrefix": "/bounty/"
            },
            {
              "scheme": "https",
              "host": "scoutvy.vercel.app",
              "pathPrefix": "/review/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#AB9FF3",
          "image": "./assets/images/scoutvy-splash.png",
          "imageWidth": 133
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scoutvy uses your camera to capture a fresh photo for bounty proof.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scoutvy uses your location to show nearby bounties and confirm you're at the spot when you capture proof."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "color": "#AB9FF3",
          "icon": "./assets/images/scoutvy-splash.png",
          "defaultChannel": "bounty-updates"
        }
      ],
      "./plugins/with-scoutvy-android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e910787-15e3-4e47-8781-ac6818f04cc3"
      }
    },
    "owner": "fake6476a"
  }
}
